---
import '../styles/global.css';
import { SITE, NAV } from '../data/site';
import ThemeToggle from '../components/ThemeToggle.astro';
import defaultImage from '../assets/sally.jpeg';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  /** Social image (absolute or root-relative). Defaults to the profile photo. */
  image?: string;
  /** Article metadata for blog posts (drives article:* + keywords meta). */
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    section?: string;
    tags?: string[];
  };
  /** schema.org JSON-LD, object or array. */
  jsonLd?: object | object[];
}

const { title, description = SITE.description, ogType = 'website', image, article, jsonLd } =
  Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const base = Astro.site ?? SITE.url;
const canonical = new URL(Astro.url.pathname, base);
const ogImage = new URL(image ?? defaultImage.src, base).toString();
const jsonLdStr = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — Blog`}
      href="/rss.xml"
    />

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14121a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {
      article && (
        <>
          {article.publishedTime && (
            <meta property="article:published_time" content={article.publishedTime} />
          )}
          {article.modifiedTime && (
            <meta property="article:modified_time" content={article.modifiedTime} />
          )}
          {article.section && <meta property="article:section" content={article.section} />}
          <meta property="article:author" content={SITE.name} />
          {(article.tags ?? []).map((t) => (
            <meta property="article:tag" content={t} />
          ))}
        </>
      )
    }
    {article?.tags?.length ? <meta name="keywords" content={article.tags.join(', ')} /> : null}

    <!-- Set the theme class before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {}
      })();
    </script>
    {jsonLdStr && <script type="application/ld+json" set:html={jsonLdStr} />}
  </head>
  <body>
    <header class="site-header">
      <nav class="nav container">
        <a class="nav__brand" href="/">{SITE.name}</a>
        <span class="nav__spacer"></span>
        {
          NAV.map((item) => (
            <a
              class="nav__link"
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <ThemeToggle />
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="nav container">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <span class="nav__spacer"></span>
        <a href={SITE.social.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
        {SITE.email && <a href={`mailto:${SITE.email}`}>Email</a>}
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>

    <!-- Add a "Copy" button to every code block. -->
    <script is:inline>
      (function () {
        document.querySelectorAll('pre').forEach(function (pre) {
          if (pre.querySelector('.copy-btn')) return;
          var btn = document.createElement('button');
          btn.className = 'copy-btn';
          btn.type = 'button';
          btn.textContent = 'Copy';
          btn.addEventListener('click', function () {
            var code = pre.querySelector('code');
            var text = code ? code.innerText : pre.innerText;
            navigator.clipboard.writeText(text).then(function () {
              btn.textContent = 'Copied';
              setTimeout(function () {
                btn.textContent = 'Copy';
              }, 1500);
            });
          });
          pre.appendChild(btn);
        });
      })();
    </script>
  </body>
</html>
