---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getAllTags } from '../../utils/tags';

const posts = await getPublishedPosts();
const tags = await getAllTags();
---
<BaseLayout title="Blog" description="Notes on product, design, creativity, and life by Sally Tang Alptekin.">
  <h1>Blog</h1>
  <p class="muted">Notes on product, creativity, and whatever I'm into lately.</p>

  {
    tags.length > 0 && (
      <ul class="tags">
        {tags.map((t) => (
          <li>
            <a class="tag" href={`/blog/tags/${t.slug}`}>
              #{t.tag} ({t.count})
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    posts.length === 0 ? (
      <p class="muted">No posts yet — check back soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <PostCard
            url={`/blog/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDate}
            tags={post.data.tags}
          />
        ))}
      </ul>
    )
  }
</BaseLayout>
