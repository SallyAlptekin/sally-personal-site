---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts, getAllTags, tagSlug } from '../../../utils/tags';
import { SITE } from '../../../data/site';

export async function getStaticPaths() {
  const tags = await getAllTags();
  const posts = await getPublishedPosts();
  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tag, posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === slug)) },
  }));
}

const { tag, posts } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Posts tagged ${tag}`,
  about: tag,
  url: new URL(`/blog/tags/${tagSlug(tag)}/`, Astro.site ?? SITE.url).toString(),
};
---
<BaseLayout
  title={`Posts tagged “${tag}”`}
  description={`${posts.length} post${posts.length === 1 ? '' : 's'} tagged ${tag} on ${SITE.name}'s blog.`}
  jsonLd={jsonLd}
>
  <a class="back-link" href="/blog">← Blog</a>
  <h1>#{tag}</h1>
  <p class="muted">
    {posts.length} post{posts.length === 1 ? '' : 's'} tagged <strong>{tag}</strong>.
  </p>
  <ul class="post-list">
    {
      posts.map((post) => (
        <PostCard
          url={`/blog/${post.id}`}
          title={post.data.title}
          description={post.data.description}
          date={post.data.pubDate}
          tags={post.data.tags}
        />
      ))
    }
  </ul>
</BaseLayout>
