---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { SITE } from '../data/site';
import profile from '../assets/sally.jpeg';
import { BIO, SKILLS } from '../data/resume';
---
<BaseLayout title="About" description={`About ${SITE.name} — ${SITE.location}.`}>
  <div class="about-head">
    <Image class="about-photo" src={profile} alt={SITE.name} width={256} height={256} />
    <div>
      <h1>About</h1>
      <p class="muted">{SITE.location}</p>
    </div>
  </div>

  {BIO.map((p) => <p>{p}</p>)}

  <section>
    <h2>Skills</h2>
    <dl class="skill-groups">
      {
        SKILLS.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd>{s.items.join(' · ')}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>
